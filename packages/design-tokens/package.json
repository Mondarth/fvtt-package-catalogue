{
  "name": "@mondarth/design-tokens",
  "version": "0.1.0",
  "description": "Mondarth's design tokens, in the Design Tokens Community Group's format (2025.10), the CSS custom properties built from them, light and dark, that every Mondarth website styles itself with, and its logos as SVG.",
  "author": "Ulenar of Mondarth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mondarth/fvtt-package-catalogue.git",
    "directory": "packages/design-tokens"
  },
  "type": "module",
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens/*": "./tokens/*",
    "./brand/*": "./brand/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens",
    "brand"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tz build",
    "prepare": "tz build",
    "test": "tz build && vitest run",
    "test:coverage": "tz build && vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:fallback": "tsc6 --noEmit",
    "icons": "node scripts/icons.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/plugin-css": "^2.10.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.1"
  }
}
