{
  "name": "Mondarth",
  "version": "2025.10",
  "description": "Mondarth's design tokens: the base set, then the theme, light or dark, then the site, whose emblem's colour it takes.",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "base/palette.tokens.json"
        },
        {
          "$ref": "base/size.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "Light or dark. Light unless the browser prefers dark, or the page says which.",
      "contexts": {
        "light": [
          {
            "$ref": "theme/light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "theme/dark.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "site": {
      "description": "Which Mondarth website: mondarth.com unless the page says which (data-site).",
      "contexts": {
        "mondarth": [
          {
            "$ref": "site/mondarth.tokens.json"
          }
        ],
        "catalogue": [
          {
            "$ref": "site/catalogue.tokens.json"
          }
        ],
        "aide": [
          {
            "$ref": "site/aide.tokens.json"
          }
        ],
        "accounts": [
          {
            "$ref": "site/accounts.tokens.json"
          }
        ]
      },
      "default": "mondarth"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/modifiers/site"
    }
  ]
}
