{
  "name": "@mondarth/accounts-contract",
  "version": "0.2.0",
  "private": true,
  "description": "The contract between Mondarth's accounts and the applications that use them: who a token is for, what their subscription entitles them to, and their use of a service, as zod schemas and types.",
  "author": "Ulenar of Mondarth",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:fallback": "tsc6 --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0"
  }
}
