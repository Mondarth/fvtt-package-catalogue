# Copy to .env for `pnpm dev`. The database is the one `pnpm db:start` runs.
DATABASE_URL=postgres://catalogue:catalogue@localhost:55432/catalogue
API_KEYS=dev-key
# Signs the website's cookies: any 32 characters or more will do for development.
AUTH_SECRET=dev-secret-dev-secret-dev-secret-dev
SITE_URL=http://localhost:5173
# Optional: signing in with GitHub, through an OAuth app whose callback is http://localhost:5173/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
LOG_LEVEL=debug
