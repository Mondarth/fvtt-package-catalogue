# Copy to .env for `pnpm dev`. The database is the one `pnpm db:start` runs.
DATABASE_URL=postgres://catalogue:catalogue@localhost:55432/catalogue
API_KEYS=dev-key
# Signs the website's cookies: any 32 characters or more will do for development.
AUTH_SECRET=dev-secret-dev-secret-dev-secret-dev
SITE_URL=http://localhost:5173
# Optional: signing in with a real provider, through an app whose callback is
# http://localhost:5173/auth/callback/<provider>. The development server offers made-up users without one.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
LOG_LEVEL=debug
