{
  "name": "@mondarth/accounts",
  "version": "0.0.0",
  "private": true,
  "description": "Mondarth's accounts: signing in, once, to every Mondarth application, the profile, and the subscription that each application's subscriber features need.",
  "author": "Ulenar of Mondarth",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "svelte-kit sync && pnpm i18n:compile",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && pnpm i18n:compile && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck": "svelte-kit sync && pnpm i18n:compile && tsc --noEmit",
    "typecheck:fallback": "svelte-kit sync && pnpm i18n:compile && tsc6 --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^3.2.2",
    "@mondarth/ui": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
