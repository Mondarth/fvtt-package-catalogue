# Copy to .env for `pnpm dev`. The database is the one `pnpm db:start` runs.
DATABASE_URL=postgres://accounts:accounts@localhost:55434/accounts
# Signs the website's cookies: any 32 characters or more will do for development.
AUTH_SECRET=dev-secret-dev-secret-dev-secret-dev
SITE_URL=http://localhost:5174
# The catalogue's development server, which a visitor is sent back to once signed in. The two share localhost, and
# so its cookie: no COOKIE_DOMAIN is needed in development.
APP_ORIGINS=http://localhost:5173
# The key the catalogue's development server calls the internal API with (its ACCOUNTS_KEY).
INTERNAL_API_KEYS=dev-internal-key-dev-internal-key-0000
# Optional: signing in with a real provider, through an app whose callback is
# http://localhost:5174/auth/callback/<provider>. The development server offers made-up users without one.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
LOG_LEVEL=debug
