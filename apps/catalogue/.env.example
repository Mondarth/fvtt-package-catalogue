# Copy to .env for `pnpm dev`. The database is the one `pnpm db:start` runs.
DATABASE_URL=postgres://catalogue:catalogue@localhost:55432/catalogue
API_KEYS=dev-key
# The accounts' development server (apps/accounts, `pnpm dev` there), on 5174: signing in, profiles and subscriptions.
# The two share localhost, and so its session cookie.
ACCOUNTS_URL=http://localhost:5174
ACCOUNTS_SITE_URL=http://localhost:5174
# One of the accounts' INTERNAL_API_KEYS (see apps/accounts/.env.example).
ACCOUNTS_KEY=dev-internal-key-dev-internal-key-0000
LOG_LEVEL=debug
