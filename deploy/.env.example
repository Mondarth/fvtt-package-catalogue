# Copy to .env beside compose.yaml. Keep .env out of version control.

# The releases to run: a version such as 0.1.0, its 0.1 or 0 line, or latest.
CATALOGUE_TAG=latest
ACCOUNTS_TAG=latest

# The Docker network SWAG is on (`docker network ls`). With SWAG's own compose project, that is usually swag_default.
SWAG_NETWORK=swag_default

# The databases' passwords, the catalogue's and the accounts'. Each goes into a connection URL, so use URL-safe
# characters: openssl rand -hex 32
POSTGRES_PASSWORD=
ACCOUNTS_POSTGRES_PASSWORD=

# The API keys accepted, separated by commas. List the new key beside the old one while clients move to it. A key
# listed as module:<key> reaches only lookups, what the EMMA module calls; a key without the prefix reaches every
# endpoint. Prefix only a key the module alone is built with: while the module and EMMA's browser extension share one,
# list it bare, as the extension calls the listing, manifests and rechecks too.
# Make one with: openssl rand -hex 32
API_KEYS=

# Optional. The most API requests one key or user may make in a minute; 300 by default.
API_RATE_PER_MINUTE=

# The catalogue's address as visitors reach it, as SWAG serves it. The accounts send visitors back to it.
SITE_URL=https://catalogue.example.org

# The accounts' address as visitors reach it, as SWAG serves it (swag/mondarth-accounts.subdomain.conf.sample): signing
# in, profiles, subscriptions and payments. Sign-in providers send visitors back to it.
ACCOUNTS_SITE_URL=https://accounts.example.org

# The domain the catalogue and the accounts share, which the accounts set their session cookie on, so that signing in
# to one signs in to both: example.org, for catalogue.example.org and accounts.example.org.
COOKIE_DOMAIN=example.org

# The catalogue's key to the accounts' internal API, on the network the two share. Make one with: openssl rand -hex 32
CATALOGUE_ACCOUNTS_KEY=

# The accounts': signs their cookies and encrypts what sign-in providers give. At least 32 characters, kept secret,
# and kept the same: changing it signs everyone out. Make one with: openssl rand -hex 32
AUTH_SECRET=

# Optional. Each sign-in provider is offered only with both its id and its secret, from an app registered with it whose
# callback (redirect) URL is ACCOUNTS_SITE_URL followed by /auth/callback/<provider>: see the deployment guide.
# GitHub: Settings, Developer settings, OAuth Apps.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google: Google Cloud console, APIs & Services, Credentials, an OAuth client ID for a web application.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Discord: Developer Portal, Applications, OAuth2.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Patreon: Patreon's developer portal, Clients & API Keys.
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=
# Optional. Mondarth's Patreon campaign: its patrons, at the least pledge an admin sets, are subscribed while they
# pledge. Without it, Patreon is a way to sign in alone. See docs/user/deployment.md, Subscriptions.
PATREON_CAMPAIGN_ID=

# Optional. The user ids (the database's, from the users table) of admins whatever their role, separated by commas:
# how the first admin is made. See docs/user/deployment.md, Admins.
ADMIN_USER_IDS=

# Optional. A GitHub token (no scopes needed) raises the worker's limit from 60 GitHub API requests an hour to 5000,
# for packages that are published on GitHub rather than listed by Foundry VTT. A GitLab token does the same for GitLab.
GITHUB_TOKEN=
GITLAB_TOKEN=

# debug, info, warn or error.
LOG_LEVEL=info
