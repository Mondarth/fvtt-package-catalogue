# Copy to .env beside compose.yaml. Keep .env out of version control.

# The release to run: a version such as 0.1.0, its 0.1 or 0 line, or latest.
CATALOGUE_TAG=latest

# The Docker network SWAG is on (`docker network ls`). With SWAG's own compose project, that is usually swag_default.
SWAG_NETWORK=swag_default

# The database's password. It goes into a connection URL, so use URL-safe characters: openssl rand -hex 32
POSTGRES_PASSWORD=

# The API keys accepted, separated by commas. List the new key beside the old one while clients move to it.
# Make one with: openssl rand -hex 32
API_KEYS=

# Signs the website's cookies and encrypts what sign-in providers give. At least 32 characters, kept secret, and kept
# the same: changing it signs everyone out. Make one with: openssl rand -hex 32
AUTH_SECRET=

# The website's address as visitors reach it, as SWAG serves it. Sign-in providers send visitors back to it.
SITE_URL=https://catalogue.example.org

# Optional. Each sign-in provider is offered only with both its id and its secret, from an app registered with it whose
# callback (redirect) URL is SITE_URL followed by /auth/callback/<provider>: see the deployment guide.
# GitHub: Settings, Developer settings, OAuth Apps.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google: Google Cloud console, APIs & Services, Credentials, an OAuth client ID for a web application.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Discord: Developer Portal, Applications, OAuth2.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Patreon: Patreon's developer portal, Clients & API Keys.
AUTH_PATREON_ID=
AUTH_PATREON_SECRET=

# Optional. A GitHub token (no scopes needed) raises the worker's limit from 60 GitHub API requests an hour to 5000,
# for packages that are published on GitHub rather than listed by Foundry VTT. A GitLab token does the same for GitLab.
GITHUB_TOKEN=
GITLAB_TOKEN=

# debug, info, warn or error.
LOG_LEVEL=info
