# Dependencies and build output
node_modules/
dist/
build/
.svelte-kit/
# Generated by paraglide from messages/
packages/*/src/lib/paraglide/
*.tsbuildinfo
*.tgz

# Tests
coverage/
*.lcov
packages/*/tests/e2e/playwright-report/
packages/*/tests/e2e/test-results/
packages/*/tests/e2e/.auth/

# Documentation
docs/_build/

# Release artefacts built by semantic-release, at the root or a package's root. Anchored: a route may be named
# releases (src/routes/…/releases/).
/releases/
/packages/*/releases/

# Logs
*.log

# Local environment; the .env.example files are committed
.env
.env.*
!.env.example

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
.eslintcache
